---
import { site } from "@/data/site";
import { ledgerStats } from "@/data/ledger";

const stats = [
  { label: "// NAME", value: site.founder },
  { label: "// BASE", value: "Warsaw, PL" },
  { label: "// SINCE", value: `${site.shippingSince}` },
  { label: "// LAB", value: `SV Lab · ${site.established}` },
];
---

<section class="about reveal" id="about">
  <div class="container-page grid">
    <div class="copy">
      <p class="section-index">
        <span class="num">01</span>
        <span>About me</span>
      </p>

      <h2>One person accountable, all the way down.</h2>

      <p>
        I'm <strong>{site.founder}</strong> — registered in Poland as
        Siarhei Sheleh. I build, market, and operate products from Warsaw, and
        I'm the one in the repo: no account manager between you and the work,
        no handoff to a bench you never met.
      </p>
      <p>
        What I own end to end is the whole surface a product needs to exist:
        <strong>research</strong>, <strong>engineering</strong>,
        <strong>go-to-market</strong>, <strong>marketing</strong>, and
        <strong>operations</strong>. Most orgs split these across five roles and
        pay for the handoffs. I run them as one loop — and ship faster because
        of it. That loop is what {ledgerStats.total} shipped products and every
        consulting engagement run on.
      </p>

      <div class="about-actions">
        <a class="about-cta primary" href="/consulting">
          Book a consultation
          <span aria-hidden="true">→</span>
        </a>
        <a class="about-cta secondary" href="/about">
          Full background
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <aside class="grid-stats" aria-label="Operator profile">
      {stats.map((s) => (
        <div class="stat-cell">
          <span class="mono-label">{s.label}</span>
          <span class="stat-val">{s.value}</span>
        </div>
      ))}
    </aside>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .copy h2 {
    margin-top: 1.5rem;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: #fff;
    max-width: 20ch;
  }

  .copy p {
    margin-top: 1.2rem;
    color: var(--color-fg-muted);
    line-height: 1.65;
    max-width: 60ch;
    font-size: 1rem;
  }

  .copy strong {
    color: #fff;
    font-weight: 500;
  }

  .copy .about-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
  }

  .copy a.about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 200ms ease, color 200ms ease, filter 200ms ease,
      border-color 200ms ease;
  }

  .copy a.about-cta.primary {
    color: #04121a;
    background: linear-gradient(135deg, #67e8f9, #22d3ee 50%, #a3e635);
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 12px 40px -16px rgba(34, 211, 238, 0.55);
  }

  .copy a.about-cta.primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  .copy a.about-cta.secondary {
    color: #67e8f9;
    border-bottom: 1px solid rgba(103, 232, 249, 0.4);
    padding-bottom: 1px;
  }

  .copy a.about-cta.secondary:hover {
    transform: translateX(2px);
    border-bottom-color: #67e8f9;
  }

  .grid-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .stat-cell {
    padding: 1.4rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stat-cell:nth-child(2n) {
    border-right: none;
  }

  .stat-cell:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: #fff;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
