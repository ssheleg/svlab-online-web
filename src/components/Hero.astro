---
import GridBg from "./GridBg.astro";
import { site } from "@/data/site";
import { ledgerStats } from "@/data/ledger";

const strip = [
  { label: "// YEARS", value: `${ledgerStats.years}+ shipping` },
  { label: "// SHIPPED", value: `${ledgerStats.total} products` },
  { label: "// LIVE", value: `${ledgerStats.live} running` },
  { label: "// BASE", value: "Warsaw, PL" },
];
---

<section class="hero" id="top">
  <GridBg fade="bottom" />

  <div class="container-page hero-inner">
    <p class="term-line prompt">
      <span class="term-user">sergey@svlab</span>
      <span>~</span>
      <span>%</span>
      <span class="term-cmd">whoami</span>
      <span class="term-caret" aria-hidden="true"></span>
    </p>

    <h1 class="hero-title reveal">{site.founder}</h1>

    <p class="hero-role mono-label reveal">{site.role}</p>

    <p class="hero-sub reveal">
      Product entrepreneur in Warsaw, Poland. {ledgerStats.years} years turning
      ideas into products people actually pay for — mobile, desktop, web. I stay
      in the work: research, the codebase, go-to-market, onboarding, retention.
      <strong>SV Lab</strong> is where I ship it.
    </p>

    <p class="hero-thesis reveal">
      <span class="thesis-key">// NOW:</span> making agents build products you
      can ship, scale, and maintain — not neuroslop.
    </p>

    <div class="hero-actions reveal">
      <a class="btn-primary" href="#skills">
        ls ./lab
        <span aria-hidden="true">↓</span>
      </a>
      <a class="btn-secondary" href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </div>

    <div class="hero-strip reveal" role="list">
      {strip.map((cell) => (
        <div class="strip-cell" role="listitem">
          <span class="mono-label">{cell.label}</span>
          <span class="strip-val">{cell.value}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .prompt {
    color: var(--color-fg-subtle);
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: #fff;
  }

  .hero-role {
    margin-top: 0.85rem;
    color: #67e8f9;
  }

  .hero-sub {
    margin-top: 1.5rem;
    max-width: 62ch;
    color: var(--color-fg-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
  }

  .hero-sub strong {
    color: #fff;
    font-weight: 500;
  }

  .hero-thesis {
    margin-top: 1.5rem;
    max-width: 60ch;
    padding-left: 1rem;
    border-left: 2px solid rgba(163, 230, 53, 0.5);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.65;
    color: #d8dde6;
  }

  .thesis-key {
    color: #a3e635;
  }

  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-strip {
    margin-top: 3.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 720px) {
    .hero-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .strip-cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .strip-val {
    font-family: var(--font-mono);
    font-size: 1.02rem;
    color: #fff;
    font-weight: 500;
    font-feature-settings: "tnum";
  }
</style>
