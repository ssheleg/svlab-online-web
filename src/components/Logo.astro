---
import { site } from "@/data/site";

interface Props {
  size?: number;
  /** `full` shows the name + mono meta line; `compact` drops the meta line. */
  variant?: "full" | "compact";
}
const { size = 30, variant = "full" } = Astro.props;
---

<a href="/" class="shield" aria-label={`${site.founder} — home`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-hidden="true"
  >
    <rect
      x="1"
      y="1"
      width="30"
      height="30"
      rx="7"
      fill="rgba(15, 21, 36, 0.9)"
      stroke="rgba(34, 211, 238, 0.55)"
      stroke-width="1.25"
    />
    <path
      d="M9 11.5L13.5 16L9 20.5"
      stroke="#67e8f9"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path d="M16.5 21H23" stroke="#a3e635" stroke-width="1.9" stroke-linecap="round" />
  </svg>

  <span class="lockup">
    <span class="name">{site.founder}</span>
    {variant === "full" && (
      <span class="meta">SV LAB · WARSAW, PL</span>
    )}
  </span>
</a>

<style>
  .shield {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .shield svg {
    flex-shrink: 0;
  }

  .lockup {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .name {
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    color: #fff;
    line-height: 1.1;
    white-space: nowrap;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    color: var(--color-fg-subtle);
    line-height: 1.1;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .shield:hover .meta {
      color: #67e8f9;
    }
  }
</style>
