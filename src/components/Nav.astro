---
import Logo from "./Logo.astro";
import { site } from "@/data/site";

const path = Astro.url.pathname;
const norm = (p: string) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);
const here = norm(path);

type Link = { label: string; href: string; match: (p: string) => boolean };

// In-page anchor links (#skills, #work) never get the active underline —
// otherwise several links light up at once on the home page and look "stuck".
// Only true page-level routes (Consulting, About) get the active state.
const links: Link[] = [
  {
    label: "Open source",
    href: "/#skills",
    match: () => false,
  },
  {
    label: "Products",
    href: "/#products",
    match: () => false,
  },
  {
    label: "Track record",
    href: "/#track-record",
    match: () => false,
  },
  {
    label: "Consulting",
    href: "/consulting",
    match: (p) => p === "/consulting" || p.startsWith("/consulting/"),
  },
  {
    label: "About",
    href: "/about",
    match: (p) => p === "/about",
  },
];

const ctaAria = `Email ${site.email}`;
---

<header class="nav-shell">
  <div class="container-page nav-row">
    <Logo />

    <nav class="links" aria-label="Primary">
      {links.map((l) => {
        const isActive = l.match(here);
        return (
          <a
            href={l.href}
            class:list={["nav-link", { "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {l.label}
          </a>
        );
      })}
    </nav>

    <span class="status" title={site.availabilityDetail}>
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-text">{site.availability}</span>
      <span class="sr-only">— {site.availabilityDetail}</span>
    </span>

    <a class="cta" href={`mailto:${site.email}`} aria-label={ctaAria}>
      <span class="cta-mono">{site.email}</span>
      <span class="cta-mono cta-mono-mobile" aria-hidden="true">EMAIL</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Below 1180px the primary links don't fit next to the shield, status, and
       email. Instead of hiding navigation behind a JS menu, they drop into a
       scrollable strip that stays one tap away. -->
  <nav class="links-mobile" aria-label="Sections">
    <div class="container-page links-mobile-row">
      {links.map((l) => {
        const isActive = l.match(here);
        return (
          <a
            href={l.href}
            class:list={["nav-link", { "is-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {l.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(12px);
    background: rgba(7, 10, 18, 0.82);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .links {
    display: none;
    margin-left: auto;
    gap: 1.4rem;
    white-space: nowrap;
  }

  .nav-link {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 200ms ease;
    position: relative;
    padding-block: 0.25rem;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms ease;
    pointer-events: none;
  }

  /* Hover/focus underline only on devices that can actually hover. Touch
     devices keep :hover stuck after a tap, so we avoid the rule there. */
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: #fff;
    }
    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      transform: scaleX(1);
    }
  }

  .nav-link:focus-visible {
    color: #fff;
    outline: none;
  }

  .nav-link.is-active {
    color: #fff;
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(52, 211, 153, 0.28);
    background: rgba(52, 211, 153, 0.07);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: #6ee7b7;
    white-space: nowrap;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border-strong);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    color: #fff;
    transition: border-color 200ms ease, background 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      border-color: rgba(34, 211, 238, 0.55);
      background: rgba(34, 211, 238, 0.06);
    }
  }

  .cta:focus-visible {
    outline: 2px solid rgba(103, 232, 249, 0.6);
    outline-offset: 2px;
  }

  .cta-mono {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
  }

  .cta-mono-mobile {
    display: none;
    letter-spacing: 0.16em;
  }

  .cta-arrow {
    font-family: var(--font-mono);
    color: #67e8f9;
  }

  .links-mobile {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .links-mobile::-webkit-scrollbar {
    display: none;
  }

  .links-mobile-row {
    display: flex;
    gap: 1.25rem;
    padding-block: 0.5rem;
    width: max-content;
    min-width: 100%;
  }

  @media (min-width: 1180px) {
    .links {
      display: inline-flex;
    }
    .status {
      margin-left: 1.25rem;
    }
    .links-mobile {
      display: none;
    }
  }

  /* Below 1180px the nav links collapse; the shield, status, and email stay. */
  @media (max-width: 1179px) {
    .nav-row {
      gap: 0.65rem;
    }
  }

  @media (max-width: 720px) {
    .cta-mono {
      display: none;
    }
    .cta-mono-mobile {
      display: inline;
    }
  }

  /* Narrow phones: the status text is the first thing to go — the pulsing dot
     alone still reads as "live", and the shield + email must not wrap. */
  @media (max-width: 400px) {
    .status-text {
      display: none;
    }
    .status {
      padding-inline: 0.45rem;
    }
  }
</style>
