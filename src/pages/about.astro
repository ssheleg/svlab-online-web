---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import AboutPage from "@/components/AboutPage.astro";
import { site } from "@/data/site";
import { projects } from "@/data/projects";
import { ledgerStats } from "@/data/ledger";

const title = `About · ${site.founder} — ${site.name}`;
const description = `${site.founder} (also Siarhei Sheleh) — technical entrepreneur in Warsaw, Poland. ${site.yearsExperience} years building and launching products used by millions across mobile, desktop, and web: AI integrations and agent systems, marketing and research tools, growth and retention, go-to-market. Available for AI advisory, transformation, and forward deployment.`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.founder,
  alternateName: site.founderAlternate,
  jobTitle: site.role,
  description,
  url: new URL("/about", site.url).toString(),
  image: new URL("/about/portrait.svg", site.url).toString(),
  email: site.email,
  worksFor: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: site.legal.city,
    addressCountry: site.legal.countryCode,
  },
  sameAs: [site.github, site.skills.repo, ...projects.map((p) => p.url)],
  knowsAbout: [
    "AI product development",
    "AI agents",
    "Coding agent workflows",
    "Go-to-market strategy",
    "Full-stack engineering",
    "AI transformation",
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/og-about.png"
  extraSchemas={[personSchema]}
>
  <Nav />
  <main id="main">
    <AboutPage />
  </main>
  <Footer />
</BaseLayout>
